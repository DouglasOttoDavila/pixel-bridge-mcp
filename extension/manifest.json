{
  "manifest_version": 3,
  "name": "PixelBridge MCP",
  "version": "0.1.0",
  "description": "Connects the local PixelBridge MCP server to an already-open ChatGPT tab.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["dist/content/chatgpt.js"],
      "run_at": "document_idle"
    }
  ]
}
